# =====================================================
# MedSafe AI — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# =====================================================

# --- Application ---
APP_NAME=MedSafe AI
APP_ENV=development
DEBUG=false
SECRET_KEY=change-this-to-a-long-random-secret-key

# --- Database ---
DATABASE_URL=postgresql://medsafe_user:medsafe_password@localhost:5432/medsafe_db
TEST_DATABASE_URL=postgresql://medsafe_user:medsafe_password@localhost:5432/medsafe_test_db

# --- JWT Authentication ---
JWT_SECRET=change-this-to-a-very-long-random-jwt-secret-key-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM / AI ---
# Supported: openai, anthropic, google
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# --- Vector Database (ChromaDB) ---
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=medsafe_knowledge

# --- OCR ---
# Path to Tesseract binary (leave empty to use system PATH)
TESSERACT_CMD=
# Tesseract language data
OCR_LANGUAGE=eng
# Maximum upload file size in MB
MAX_UPLOAD_SIZE_MB=10

# --- External APIs ---
# OpenFDA Drug API (no key required for basic use)
OPENFDA_API_BASE=https://api.fda.gov/drug
OPENFDA_API_KEY=

# RxNorm API (free, no key required)
RXNORM_API_BASE=https://rxnav.nlm.nih.gov/REST

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Redis (optional, for caching/rate limiting) ---
REDIS_URL=redis://localhost:6379/0

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- File Storage ---
UPLOAD_DIR=./data/uploads
